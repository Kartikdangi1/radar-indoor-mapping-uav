<?xml version="1.0"?>
<package format="3">
  <name>fused_odometry</name>
  <version>0.2.0</version>
  <description>Fused odometry system combining IMU, LiDAR height, and ARS548 Radar ego-velocity estimation</description>
  <maintainer email="you@email.com">You</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>pcl_conversions</depend>
  <depend>pcl_ros</depend>
  <depend>eigen</depend>
  <depend>ars548_messages</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>